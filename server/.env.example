# NovaFlix Server Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# TMDB
TMDB_ACCESS_TOKEN=your_tmdb_access_token

# JWT (MUST be >= 32 chars, server will refuse to start without it)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Google OAuth (optional - enables Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Social OAuth (Claim Profile verification + social login)
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
SOCIAL_OAUTH_REDIRECT_BASE=

# App URL
APP_URL=http://localhost:3000

# Email (Brevo/Sendinblue)
BREVO_API_KEY=xkeysib_xxxxx
BREVO_EMAIL=your_email@domain.com
BREVO_NAME=NovaFlix

# Paystack
PAYSTACK_PUBLIC_KEY=pk_live_xxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/success

# Flutterwave
FLW_PUBLIC_KEY=FLWPUBK_live_xxxxx
FLW_SECRET_KEY=FLWSECK_live_xxxxx
FLW_ENCRYPTION_KEY=FLWSECK_live_xxxxx

# Cloudflare R2 (S3-compatible storage)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=novaflix
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# Streaming stability
ENABLE_PROXY=true

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your_email@domain.com

# Port
PORT=3030

# News APIs
NEWSAPI_KEY=your_newsapi_key
NEWSDATA_KEY=your_newsdata_key
APITUBE_KEY=your_apitube_key
# Dev login fallback (when DATABASE_URL unavailable)
DEV_LOGIN_EMAIL=dev@novaflix.local
DEV_LOGIN_PASSWORD=NovaflixDev123!
